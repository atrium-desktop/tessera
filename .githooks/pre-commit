#!/bin/sh
set -eu

# Read-only pre-commit guardrail for the dual-worktree Optics workflow.
#
# - Never rewrites the Git index.
# - Always refuses a staged `.cargo/config.toml` (machine-local, gitignored).
# - In local Optics patch mode (`.cargo/config.toml` carries the Optics
#   `[patch]` table), refuses staged `Cargo.lock` edits and release-shaped
#   version bumps so locally patched lockfile entries never enter Git history.
# - In canonical mode (no Optics `[patch]`), validates `Cargo.lock` with
#   `cargo metadata --locked` whenever a manifest or lockfile is staged.

config_path=".cargo/config.toml"
patch_header='[patch."https://github.com/ming2k/optics"]'
changed=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$changed" | grep -q '^\.cargo/config\.toml$'; then
    printf '%s\n' \
        "Refusing to commit .cargo/config.toml." \
        "It is a machine-local Optics override; keep it untracked." >&2
    exit 1
fi

if [ -f "$config_path" ] && grep -Fqx "$patch_header" "$config_path"; then
    if git diff --cached -U0 -- Cargo.toml | grep -Eq '^\+version = "'; then
        printf '%s\n' \
            "Local Optics mode: refusing a release-shaped commit." \
            "The staged Cargo.toml bumps the workspace version, but local" \
            "mode cannot produce a committable canonical Cargo.lock." \
            "Perform release version bumps and canonical lockfile generation" \
            "directly inside the primary main worktree (../tessera/)." >&2
        exit 1
    fi

    if printf '%s\n' "$changed" | grep -q '^Cargo\.lock$'; then
        printf '%s\n' \
            "Local Optics mode: refusing to commit a locally patched Cargo.lock." \
            "Unstage it with: git restore --staged -- Cargo.lock" \
            "Regenerate and commit the canonical Cargo.lock in the primary" \
            "main worktree (../tessera/) when promoting or changing dependencies." >&2
        exit 1
    fi

    exit 0
fi

if printf '%s\n' "$changed" | grep -Eq '(^|/)(Cargo\.toml|Cargo\.lock)$'; then
    printf '%s\n' "Canonical Optics mode: validating Cargo.lock."
    cargo metadata --locked --format-version 1 >/dev/null
fi
