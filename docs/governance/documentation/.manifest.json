  "schema": "docgov/manifest",
  "schema_version": 2,
  "name": "docgov",
  "description": "Universal documentation governance: multi-dimensional coordinate core with pluggable vertical domain entities.",
  "license": "MIT",
  "homepage": "https://github.com/ming2k/docgov",
  "protocol_version": "0.0.4",
  "protocol_history": [
    {
      "version": "0.0.4",
      "date": "2026-03-31",
      "status": "current",
      "summary": "Protocol v0.0.4: Modernize specification core and profiles, eliminate pseudo-academic jargon, enforce in-place frontmatter lifecycles (abolishing physical archive moves), and unify invariant taxonomies under SSOT."
    },
    {
      "version": "0.0.3",
      "date": "2026-03-31",
      "status": "superseded",
      "summary": "Protocol v0.0.3: Distributes pre-decision RFC governance architecture standard (RFC-0002), aligns core system invariant headers, and locks protocol assets."
    },
    {
      "version": "0.0.2",
      "date": "2026-10-05",
      "status": "superseded",
      "summary": "Protocol v0.0.2: Distributes the canonical .docgov.yml adoption template (spec/default-config.yml) as a first-class, manifest-registered spec asset, enabling `docgov init` to materialize configuration directly from the sovereign specification rather than hard-coding it in the engine."
    },
    {
      "version": "0.0.1",
      "date": "2026-10-02",
      "status": "superseded",
      "summary": "Protocol v0.0.1 Initial Release: Zero-Vendoring Architecture, Flat Knowledge Topology, in-place Frontmatter lifecycle, and bifurcated invariants (INV-LINT machine layer and INV-AGENT cognitive layer)."
    }
  ],
  "update_policy": "Semantic versioning on protocol_version. MAJOR: a repository following the old protocol would be non-compliant without migration work. MINOR: new optional profiles or non-breaking additions; old content stays valid. PATCH: clarifications and typo-level changes that do not alter any rule.",
